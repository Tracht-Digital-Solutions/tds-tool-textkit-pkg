---
// Password-generator tool shell — hosts the client-side island.
// See UtmBuilder.astro for why `lang` defaults to German at both levels.
import PasswordGenerator from "../islands/PasswordGenerator.tsx";

interface Props {
  lang?: "de" | "en";
}

const { lang = "de" } = Astro.props;
---

<div class="tool tool--password">
  <PasswordGenerator client:load lang={lang} />
</div>
